<FindBugsFilter>
  <!-- These public GWT compatibility aliases deliberately retain the upstream
       simple name while extending the implementation in its newer package. -->
  <Match>
    <Or>
      <Class name="com.google.gwt.user.client.Element"/>
      <Class name="com.google.gwt.i18n.client.DateTimeFormat"/>
      <Class name="com.google.gwt.event.shared.EventBus"/>
      <Class name="com.google.gwt.event.shared.UmbrellaException"/>
    </Or>
    <Bug pattern="NM_SAME_SIMPLE_NAME_AS_SUPERCLASS"/>
  </Match>
</FindBugsFilter>
