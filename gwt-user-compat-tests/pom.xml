<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>teavm-compat</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>gwt-user-compat-tests</artifactId>
  <name>TeaVM GWT Compatibility Contract Tests</name>
  <dependencies>
    <dependency><groupId>io.instanto</groupId><artifactId>gwt-uibinder-processor</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency><groupId>io.instanto</groupId><artifactId>gwt-modular-services-compat</artifactId><version>${project.version}</version><scope>test</scope></dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>gwt-user-compat</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>gwt-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-junit</artifactId>
      <version>${teavm.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>elemental2-compat</artifactId>
      <version>${elemental2.compat.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
        <executions><execution><id>default-testCompile</id><configuration>
          <proc>full</proc>
          <annotationProcessors><annotationProcessor>io.instanto.widgets.processor.UiBinderProcessor</annotationProcessor></annotationProcessors>
        </configuration></execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions><execution>
          <id>material-contract-sources</id>
          <phase>generate-test-sources</phase>
          <goals><goal>copy-resources</goal></goals>
          <configuration>
            <outputDirectory>${project.build.directory}/generated-test-sources/contracts</outputDirectory>
            <resources><resource>
              <directory>../gwt-api/src/main/java</directory>
              <includes><include>**/Material*Contracts.java</include></includes>
            </resource></resources>
          </configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions><execution>
          <id>compile-shared-material-contracts-for-teavm</id>
          <phase>generate-test-sources</phase>
          <goals><goal>add-test-source</goal></goals>
          <configuration><sources><source>${project.build.directory}/generated-test-sources/contracts</source></sources></configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <systemPropertyVariables>
            <teavm.junit.target>${project.build.directory}/teavm-tests</teavm.junit.target>
            <teavm.junit.js.runner>${teavm.junit.js.runner}</teavm.junit.js.runner>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>
  <profiles>
    <profile>
      <id>browser-coverage</id>
      <properties>
        <teacoco.version>0.1.0-SNAPSHOT</teacoco.version>
      </properties>
      <build><plugins>
        <plugin>
          <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId>
          <executions><execution>
            <id>preserve-jvm-coverage-for-browser-union</id>
            <phase>initialize</phase><goals><goal>merge</goal></goals>
            <configuration>
              <fileSets><fileSet>
                <directory>${maven.multiModuleProjectDirectory}</directory>
                <includes><include>*/target/jacoco.exec</include></includes>
              </fileSet></fileSets>
              <destFile>${project.build.directory}/jvm-baseline.exec</destFile>
            </configuration>
          </execution></executions>
        </plugin>
        <plugin>
          <groupId>io.instanto</groupId><artifactId>teacoco-maven-plugin</artifactId>
          <version>${teacoco.version}</version>
          <configuration>
            <sourceRoots><sourceRoot>${project.basedir}/../gwt-user-compat/src/main/java</sourceRoot></sourceRoots>
            <dependencyIncludes><dependencyInclude>io.instanto:gwt-user-compat</dependencyInclude></dependencyIncludes>
            <executionData><file>${project.build.directory}/jvm-baseline.exec</file></executionData>
          </configuration>
          <executions><execution><goals><goal>prepare</goal><goal>report</goal></goals></execution></executions>
        </plugin>
      </plugins></build>
    </profile>
  </profiles>
</project>
