<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>teavm-compat</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jsinterop-binding-generator</artifactId>
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.javaparser</groupId>
      <artifactId>javaparser-core</artifactId>
      <version>3.28.2</version>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
          <include>upstream/provenance.json</include>
          <include>upstream/bindings-lock.json</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <phase>process-classes</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>io.instanto.compat.GenerateBindings</mainClass>
              <arguments>
                <argument>${project.basedir}/../target/compat/elemental2</argument>
                <argument>${project.basedir}/../upstream/elemental2-core-1.2.3.jar</argument>
                <argument>${project.basedir}/../upstream/elemental2-dom-1.2.3.jar</argument>
                <argument>${project.basedir}/../upstream/elemental2-promise-1.2.3.jar</argument>
                <argument>${project.basedir}/../upstream/elemental2-svg-1.2.3.jar</argument>
                <argument>${project.basedir}/../upstream/elemental2-webstorage-1.2.3.jar</argument>
              </arguments>
            </configuration>
            <id>elemental2-bindings</id>
          </execution>
          <execution>
            <phase>process-classes</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>io.instanto.compat.GenerateBindings</mainClass>
              <arguments>
                <argument>${project.basedir}/../target/compat/services</argument>
                <argument>${project.basedir}/../upstream/modular-services</argument>
              </arguments>
            </configuration>
            <id>modular-bindings</id>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
